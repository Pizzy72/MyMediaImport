<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#FFF5F7FA</Color>
    <Color x:Key="PanelBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="ControlBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="ForegroundColor">#FF172033</Color>
    <Color x:Key="MutedForegroundColor">#FF5E687A</Color>
    <Color x:Key="BorderColor">#FFCBD2DC</Color>
    <Color x:Key="AccentColor">#FF2867C7</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="SelectionColor">#FFDCEAFF</Color>
    <Color x:Key="SelectionForegroundColor">#FF10213A</Color>
    <Color x:Key="HoverColor">#FFE9F1FC</Color>
    <Color x:Key="FocusColor">#FF2867C7</Color>
    <Color x:Key="DisabledColor">#FFE7EAF0</Color>
    <Color x:Key="DisabledForegroundColor">#FF7A8494</Color>
    <Color x:Key="PrimaryButtonBackgroundColor">#FF2867C7</Color>
    <Color x:Key="PrimaryButtonForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="PrimaryButtonHoverBackgroundColor">#FF1F57AD</Color>
    <Color x:Key="PrimaryButtonPressedBackgroundColor">#FF19498F</Color>
    <Color x:Key="PrimaryButtonFocusBorderColor">#FF153D75</Color>
    <Color x:Key="PrimaryButtonDisabledBackgroundColor">#FFD8DEE8</Color>
    <Color x:Key="PrimaryButtonDisabledForegroundColor">#FF566070</Color>
    <Color x:Key="PhotoBadgeBackgroundColor">#FF0F766E</Color>
    <Color x:Key="VideoBadgeBackgroundColor">#FF6D3FB3</Color>
    <Color x:Key="MediaBadgeForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="SuccessColor">#FF18794E</Color>
    <Color x:Key="SuccessBackgroundColor">#FFE8F5EE</Color>
    <Color x:Key="WarningColor">#FF9A6700</Color>
    <Color x:Key="WarningBackgroundColor">#FFFFF4CE</Color>
    <Color x:Key="ErrorColor">#FFC42B1C</Color>
    <Color x:Key="ErrorBackgroundColor">#FFFDE7E9</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{DynamicResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{DynamicResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{DynamicResource ForegroundColor}" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="{DynamicResource MutedForegroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{DynamicResource AccentForegroundColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource SelectionColor}" />
    <SolidColorBrush x:Key="SelectionForegroundBrush" Color="{DynamicResource SelectionForegroundColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{DynamicResource FocusColor}" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{DynamicResource DisabledColor}" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="{DynamicResource DisabledForegroundColor}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{DynamicResource PrimaryButtonBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{DynamicResource PrimaryButtonForegroundColor}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{DynamicResource PrimaryButtonHoverBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{DynamicResource PrimaryButtonPressedBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryButtonFocusBorderBrush" Color="{DynamicResource PrimaryButtonFocusBorderColor}" />
    <SolidColorBrush x:Key="PrimaryButtonDisabledBackgroundBrush" Color="{DynamicResource PrimaryButtonDisabledBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryButtonDisabledForegroundBrush" Color="{DynamicResource PrimaryButtonDisabledForegroundColor}" />
    <SolidColorBrush x:Key="PhotoBadgeBackgroundBrush" Color="{DynamicResource PhotoBadgeBackgroundColor}" />
    <SolidColorBrush x:Key="VideoBadgeBackgroundBrush" Color="{DynamicResource VideoBadgeBackgroundColor}" />
    <SolidColorBrush x:Key="MediaBadgeForegroundBrush" Color="{DynamicResource MediaBadgeForegroundColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{DynamicResource SuccessBackgroundColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{DynamicResource WarningBackgroundColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="{DynamicResource ErrorBackgroundColor}" />

    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{DynamicResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{DynamicResource ForegroundColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{DynamicResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{DynamicResource ForegroundColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource SelectionColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource SelectionForegroundColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{DynamicResource DisabledForegroundColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="{DynamicResource BorderColor}" />
</ResourceDictionary>
