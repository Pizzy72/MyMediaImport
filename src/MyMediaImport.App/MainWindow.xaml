<Window x:Class="MyMediaImport.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MyMediaImport.App"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{x:Static local:ApplicationVersion.WindowTitle}"
        Icon="Assets/MyMediaImport.ico"
        Width="1180"
        Height="760"
        MinWidth="760"
        MinHeight="560"
        Loaded="MainWindow_OnLoaded"
        Closing="MainWindow_OnClosing"
        Closed="MainWindow_OnClosed">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Theme"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding SelectedTheme}"
                      AutomationProperties.AutomationId="ThemeSelector"
                      MinWidth="105" />
            <TextBlock Grid.Column="2"
                       Text="Text"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       Margin="18,0,8,0" />
            <ComboBox Grid.Column="3"
                      ItemsSource="{Binding FontSizes}"
                      SelectedItem="{Binding SelectedFontSize}"
                      AutomationProperties.AutomationId="FontSizeSelector"
                      MinWidth="105" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="310" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="3*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          IsEnabled="{Binding IsImportInteractionEnabled}">
                <StackPanel Margin="0,0,4,0">
                    <GroupBox Header="Media source">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ComboBox ItemsSource="{Binding Devices}"
                                      SelectedItem="{Binding SelectedDevice}"
                                      DisplayMemberPath="DisplayLabel"
                                      ToolTip="Portable device used as the media source" />
                            <Button Grid.Column="1"
                                    Content="Refresh"
                                    Command="{Binding RefreshDevicesCommand}"
                                    AutomationProperties.AutomationId="RefreshDevicesButton"
                                    Margin="7,0,0,0" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                       Text="{Binding DeviceStatus}"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="0,6,0,0" />
                            <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right"
                                        Content="Choose folder..."
                                        IsEnabled="{Binding CanChooseSourceFolder}"
                                        Margin="8,0,0,0"
                                        Click="ChooseSourceFolder_OnClick"
                                        AutomationProperties.AutomationId="ChooseSourceFolderButton" />
                                <TextBlock Text="{Binding SourceFolderText}"
                                           ToolTip="{Binding SourceFolderText}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           AutomationProperties.AutomationId="SourceFolderPath" />
                            </DockPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Time selection">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding TimeSelections}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedTimeSelection}"
                                      AutomationProperties.AutomationId="TimeSelectionSelector" />

                            <Grid Margin="0,8,0,0"
                                  Visibility="{Binding IsLastDaysSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label Content="Number of days" Style="{StaticResource CompactLabelStyle}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding LastDays, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="0,8,0,0"
                                  Visibility="{Binding IsFromToSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label Content="From" Style="{StaticResource CompactLabelStyle}" />
                                <DatePicker Grid.Column="1"
                                            SelectedDate="{Binding FromDate}"
                                            AutomationProperties.AutomationId="FromDatePicker" />
                                <Label Grid.Column="2" Content="To" Style="{StaticResource CompactLabelStyle}"
                                       Margin="10,0,0,0" />
                                <DatePicker Grid.Column="3"
                                            SelectedDate="{Binding ToDate}"
                                            AutomationProperties.AutomationId="ToDatePicker" />
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Capture timezone">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding TimeZoneSelections}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedTimeZone}"
                                      AutomationProperties.AutomationId="CaptureTimeZoneSelector" />
                            <TextBox Text="{Binding FixedOffset, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsFixedOffsetSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     AutomationProperties.AutomationId="FixedOffsetTextBox"
                                     ToolTip="Fixed UTC offset, for example +02:00 or -05:00"
                                     Margin="0,8,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Extensions">
                        <TextBox Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Comma-separated extensions without leading dots" />
                    </GroupBox>

                    <GroupBox Header="Target path template">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TargetTemplate, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="TargetTemplateTextBox"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinLines="2"
                                     VerticalContentAlignment="Top"
                                     HorizontalScrollBarVisibility="Auto" />
                            <Button Grid.Column="1" Content="i" FontWeight="Bold" MinWidth="32"
                                    Padding="8,6" Margin="7,0,0,0" VerticalAlignment="Top"
                                    ToolTip="Show target path template placeholders"
                                    AutomationProperties.Name="Target path template help"
                                    AutomationProperties.AutomationId="TargetTemplateHelpButton"
                                    Click="TargetTemplateHelpButton_OnClick" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Existing files">
                        <ComboBox ItemsSource="{Binding ExistingFilePolicies}"
                                  SelectedItem="{Binding ExistingFilePolicy}"
                                  AutomationProperties.AutomationId="ExistingFilePolicySelector" />
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="240">
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="*" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTargetPathDetailsVisible}" Value="True">
                                        <Setter Property="Height" Value="11*" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="Auto" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTargetPathDetailsVisible}" Value="True">
                                        <Setter Property="Height" Value="9*" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                </Grid.RowDefinitions>

                <GroupBox Header="Media preview" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PreviewStatus}"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding PreviewStatusToolTip}"
                                       AutomationProperties.AutomationId="PreviewStatus"
                                       VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsLoadingPreview, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         AutomationProperties.AutomationId="PreviewBusyIndicator"
                                         Width="120"
                                         Margin="12,0,0,0" />
                        </Grid>

                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                Margin="0,10,0,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        MaxWidth="460"
                                        Margin="24"
                                        Visibility="{Binding IsPreviewEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="No media to display"
                                           Style="{StaticResource SectionTitleStyle}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Choose a device and filters, then load the preview. No files will be imported."
                                           Style="{StaticResource MutedTextStyle}"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding PreviewItems}"
                                 SelectionMode="Multiple"
                                 IsEnabled="{Binding IsImportInteractionEnabled}"
                                 Visibility="{Binding HasPreviewItems, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 AutomationProperties.AutomationId="PreviewList"
                                 Margin="0,10,0,0"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem"
                                       BasedOn="{StaticResource MediaPreviewItemContainerStyle}">
                                    <Setter Property="IsSelected"
                                            Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="144" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                MinHeight="96">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}"
                                                       Width="144"
                                                       Height="96"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="{Binding ThumbnailStatus}"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="8"
                                                           ToolTip="{Binding ThumbnailDiagnostic}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding NameToolTip}" />
                                            <TextBlock Text="{Binding CaptureTimeText}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding SizeText}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                            <Border Style="{StaticResource MediaKindBadgeStyle}">
                                                <TextBlock Text="{Binding MediaKindText}"
                                                           Style="{StaticResource MediaKindBadgeTextStyle}" />
                                            </Border>
                                            <Border Background="{DynamicResource AccentBrush}"
                                                    CornerRadius="3"
                                                    Padding="7,3"
                                                    Margin="0,6,0,0"
                                                    ToolTip="{Binding ImportDiagnostic}"
                                                    Visibility="{Binding HasImportResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding ImportStatusText}"
                                                           Foreground="{DynamicResource AccentForegroundBrush}"
                                                           TextWrapping="NoWrap" />
                                            </Border>
                                            <CheckBox Content="Selected"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      HorizontalAlignment="Center"
                                                      VerticalContentAlignment="Center"
                                                      Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <WrapPanel>
                                    <Button Content="Select all"
                                            Command="{Binding SelectAllCommand}"
                                            AutomationProperties.AutomationId="SelectAllButton"
                                            Margin="0,0,8,0" />
                                    <Button Content="Select none"
                                            Command="{Binding SelectNoneCommand}"
                                            AutomationProperties.AutomationId="SelectNoneButton" />
                                </WrapPanel>
                                <TextBlock Text="{Binding SelectedSummary}"
                                           Style="{StaticResource MutedTextStyle}"
                                           AutomationProperties.AutomationId="SelectionSummary"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1">
                                <Button Content="Load preview"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding LoadPreviewCommand}"
                                        AutomationProperties.AutomationId="LoadPreviewButton"
                                        Margin="8,0,0,0" />
                                <Button Content="Import selected"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ImportSelectedCommand}"
                                        AutomationProperties.AutomationId="ImportSelectedButton"
                                        Margin="8,0,0,0" />
                                <Button Content="Cancel import"
                                        Command="{Binding CancelImportCommand}"
                                        AutomationProperties.AutomationId="CancelImportButton"
                                        Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="8,0,0,0" />
                            </WrapPanel>
                        </Grid>

                        <Border Grid.Row="3"
                                CornerRadius="4"
                                Padding="9"
                                Margin="0,10,0,0"
                                Visibility="{Binding HasImportStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImportSuccessful}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsImportCancelled}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsImportFailed}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="18"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Visibility="{Binding IsImportSuccessful, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               AutomationProperties.Name="Import successful" />
                                    <TextBlock Text="&#xE711;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource WarningBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Visibility="{Binding IsImportCancelled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               AutomationProperties.Name="Import cancelled" />
                                    <TextBlock Text="&#xE783;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource ErrorBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Visibility="{Binding IsImportFailed, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               AutomationProperties.Name="Import failed" />
                                    <TextBlock Text="{Binding ImportStatus}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="ImportStatus">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsImportSuccessful}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsImportCancelled}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsImportFailed}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ImportFileProgress}"
                                               Style="{StaticResource MutedTextStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ImportFileProgress}"
                                               AutomationProperties.AutomationId="ImportFileProgress" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ImportByteProgressLayoutText, Mode=OneWay}"
                                               Style="{StaticResource MutedTextStyle}"
                                               FontFamily="Consolas"
                                               Visibility="Hidden"
                                               Margin="12,0,0,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ImportByteProgress, Mode=OneWay}"
                                               Style="{StaticResource MutedTextStyle}"
                                               FontFamily="Consolas"
                                               TextAlignment="Right"
                                               Margin="12,0,0,0"
                                               AutomationProperties.AutomationId="ImportByteProgress" />
                                    <ProgressBar Grid.Column="2"
                                                 Minimum="0"
                                                 Maximum="{Binding ImportTotalCount, Mode=OneWay}"
                                                 Value="{Binding ImportProgressValue, Mode=OneWay}"
                                                 Margin="12,0,0,0"
                                                 AutomationProperties.AutomationId="ImportProgressBar">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsImportSuccessful}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsImportCancelled}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsImportFailed}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                </Grid>
                                <WrapPanel Grid.Row="2"
                                           Margin="0,6,0,0"
                                           AutomationProperties.AutomationId="ImportCountsSummary">
                                    <TextBlock Margin="0,0,14,0">
                                        <Run Text="Imported: " />
                                        <Run Text="{Binding ImportedCount, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,0,14,0">
                                        <Run Text="Skipped: " />
                                        <Run Text="{Binding SkippedCount, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,0,14,0">
                                        <Run Text="Already identical: " />
                                        <Run Text="{Binding AlreadyImportedCount, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Failed: " />
                                        <Run Text="{Binding ImportFailedCount, Mode=OneWay}" />
                                    </TextBlock>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="Target path preview" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TargetPathStatus}"
                                       Style="{StaticResource MutedTextStyle}"
                                       AutomationProperties.AutomationId="TargetPathStatus"
                                       Visibility="{Binding IsTargetPathDetailsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ProgressBar Grid.Column="1"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsPlanningTargetPaths, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         AutomationProperties.AutomationId="TargetPathBusyIndicator"
                                         Width="90"
                                         Margin="12,0,0,0" />
                            <Button Grid.Column="2"
                                    Content="{Binding TargetPathDetailsToggleText}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ToggleTargetPathDetailsCommand}"
                                    AutomationProperties.AutomationId="ToggleTargetPathDetailsButton"
                                    Margin="10,0,0,0" />
                        </Grid>

                        <WrapPanel Grid.Row="1"
                                   Margin="0,8,0,0"
                                   AutomationProperties.AutomationId="TargetPathSummary">
                            <TextBlock Margin="0,0,14,0">
                                <Run Text="Selected: " /><Run Text="{Binding TargetSelectedCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,0,14,0">
                                <Run Text="Ready: " /><Run Text="{Binding TargetReadyCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,0,14,0">
                                <Run Text="Already identical: " /><Run Text="{Binding TargetAlreadyImportedCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,0,14,0">
                                <Run Text="Conflicts/errors: " /><Run Text="{Binding TargetConflictCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="Total: " /><Run Text="{Binding TargetTotalSizeText, Mode=OneWay}" />
                            </TextBlock>
                        </WrapPanel>

                        <Grid Grid.Row="2"
                              Margin="0,6,0,0"
                              Visibility="{Binding IsTargetPathDetailsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Background="{DynamicResource WindowBackgroundBrush}">
                                <TextBlock Text="Target paths for the current selection will appear here."
                                           Style="{StaticResource MutedTextStyle}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="10"
                                           Visibility="{Binding IsTargetPathPreviewEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Border>

                            <ListBox ItemsSource="{Binding TargetPathItems}"
                                     ItemContainerStyle="{StaticResource MediaPreviewItemContainerStyle}"
                                     Visibility="{Binding HasTargetPathItems, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     AutomationProperties.AutomationId="TargetPathList"
                                     Grid.IsSharedSizeScope="True"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"
                                                                  MinWidth="90"
                                                                  SharedSizeGroup="TargetPathSource" />
                                                <ColumnDefinition Width="*" MinWidth="140" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SourceName}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SourceName}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TargetPath}"
                                                       TextAlignment="Left"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding TargetPath}"
                                                       Margin="18,0,10,0" />
                                            <Border Grid.Column="2"
                                                    Background="{DynamicResource SelectionBrush}"
                                                    CornerRadius="3"
                                                    Padding="6,2"
                                                    ToolTip="{Binding Diagnostic}">
                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="{DynamicResource SelectionForegroundBrush}"
                                                           TextWrapping="NoWrap" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
