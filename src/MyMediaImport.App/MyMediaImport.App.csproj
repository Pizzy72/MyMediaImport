<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MyMediaImport.Core\MyMediaImport.Core.csproj" />
    <ProjectReference Include="..\MyMediaImport.Windows\MyMediaImport.Windows.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationIcon>Assets\MyMediaImport.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\MyMediaImport.ico" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToPublishDirectory="Always" />
    <None Include="$(NuGetPackageRoot)microsoft.netcore.app.runtime.$(RuntimeIdentifier)\$(RuntimeFrameworkVersion)\LICENSE.TXT"
          Link="DOTNET-LICENSE.txt"
          CopyToPublishDirectory="Always"
          Condition="'$(SelfContained)' == 'true'" />
    <None Include="$(NuGetPackageRoot)microsoft.netcore.app.runtime.$(RuntimeIdentifier)\$(RuntimeFrameworkVersion)\THIRD-PARTY-NOTICES.TXT"
          Link="DOTNET-THIRD-PARTY-NOTICES.txt"
          CopyToPublishDirectory="Always"
          Condition="'$(SelfContained)' == 'true'" />
    <None Include="$(NuGetPackageRoot)microsoft.windowsdesktop.app.runtime.$(RuntimeIdentifier)\$(RuntimeFrameworkVersion)\LICENSE"
          Link="DOTNET-WINDOWS-DESKTOP-LICENSE.txt"
          CopyToPublishDirectory="Always"
          Condition="'$(SelfContained)' == 'true'" />
  </ItemGroup>

  <Target Name="ValidateReleaseNotices" BeforeTargets="Publish">
    <Error Condition="!Exists('..\..\LICENSE')" Text="The MyMediaImport license file is missing." />
    <Error Condition="'$(SelfContained)' == 'true' and '$(RuntimeFrameworkVersion)' == ''"
           Text="A self-contained publish must specify RuntimeFrameworkVersion explicitly." />
    <Error Condition="'$(SelfContained)' == 'true' and !Exists('$(NuGetPackageRoot)microsoft.netcore.app.runtime.$(RuntimeIdentifier)\$(RuntimeFrameworkVersion)\LICENSE.TXT')"
           Text="The version-specific .NET runtime license was not found for $(RuntimeIdentifier) $(RuntimeFrameworkVersion)." />
    <Error Condition="'$(SelfContained)' == 'true' and !Exists('$(NuGetPackageRoot)microsoft.netcore.app.runtime.$(RuntimeIdentifier)\$(RuntimeFrameworkVersion)\THIRD-PARTY-NOTICES.TXT')"
           Text="The version-specific .NET runtime notices were not found for $(RuntimeIdentifier) $(RuntimeFrameworkVersion)." />
    <Error Condition="'$(SelfContained)' == 'true' and !Exists('$(NuGetPackageRoot)microsoft.windowsdesktop.app.runtime.$(RuntimeIdentifier)\$(RuntimeFrameworkVersion)\LICENSE')"
           Text="The version-specific Windows Desktop runtime license was not found for $(RuntimeIdentifier) $(RuntimeFrameworkVersion)." />
  </Target>

</Project>
